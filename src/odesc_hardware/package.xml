<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>odesc_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control hardware interface for ODrive ODESC boards via CAN</description>
  <maintainer email="ivanrabei@gmail.com">Ivan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/odesc_hardware.xml"/>
  </export>
</package>
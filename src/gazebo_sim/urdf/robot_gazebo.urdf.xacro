<?xml version="1.0"?>
<robot name="selena_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/mobile_base.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/gripper.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/ros2_control.sim.xacro" />

    <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find robot_bringup)/config/robot_controllers.yaml</parameters>
            <ros>
                <remapping>~/robot_description:=/robot_description</remapping>
            </ros>
        </plugin>
    </gazebo>

</robot>

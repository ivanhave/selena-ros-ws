# Goal — move gantry to absolute (x, y, z) in joint space (meters)
# robot_gantry internally sequences: Z→0, then XY, then Z→target
float64 x
float64 y
float64 z
---
# Result
bool    success
string  message
float64 final_x
float64 final_y
float64 final_z
---
# Feedback
string  phase        # "z_retract" | "xy_move" | "z_lower"
float64 current_x
float64 current_y
float64 current_z

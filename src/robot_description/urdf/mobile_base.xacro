<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


    <xacro:property name="frame_ground_offset" value="0.4125" />

    <xacro:property name="leg_offset_y" value="0.5795" />
    <xacro:property name="leg_offset_z" value="0.03" />

    <xacro:property name="back_bar_offset_x" value="0.305" />
    <xacro:property name="back_bar_offset_z" value="0.045" />

    <xacro:property name="front_wheel_offset_x" value="0.275" />
    <xacro:property name="back_wheel_offset_x" value="0.305" />
    <xacro:property name="wheel_offset_y" value="0.058" />
    <xacro:property name="wheel_offset_z" value="0.300" />

    <xacro:property name="z_axis_offset_x" value="0.025" />
    <xacro:property name="z_axis_offset_z" value="0.35" />

    <xacro:property name="x_axis_travel" value="0.845" />
    <xacro:property name="y_axis_travel" value="0.29" />
    <xacro:property name="z_axis_travel" value="0.25" />

    <xacro:property name="wheel_radius" value="0.0825" />
    <xacro:property name="wheel_width"  value="0.10"   />   <!-- tread width in Y (axle direction) -->


    ``----- LINKS -----

    <link name="base_footprint" />         

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/main_frame.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />              
            <material name="grey" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.614 1.338 0.06" /> 
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <mass value="6.54888"/> 
            <inertia 
                ixx="0.9946" ixy="0.0" ixz="0.0" 
                iyy="0.3190" iyz="0.0" 
                izz="1.311" />
        </inertial>
    </link>



    <link name="gantry_origin_link"/>

    

    <link name="left_leg_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/leg.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <origin xyz="0 0 -0.15" rpy="0 0 0" />
            <geometry>
                <box size="0.625 0.054 0.37455" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014231 0.0 -0.143044" rpy="0 0 0"/>           
            <mass value="2.33849"/>           
            <inertia 
                ixx="0.03813" ixy="0.0" ixz="0.0" 
                iyy="0.1843" iyz="0.0" 
                izz="0.1468" />
        </inertial>
    </link>

    <link name="right_leg_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/leg.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <origin xyz="0 0 -0.15" rpy="0 0 0" />
            <geometry>
                <box size="0.625 0.054 0.37455" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014231 0.0 -0.143044" rpy="0 0 0"/>
            <mass value="2.33849"/>
            <inertia 
                ixx="0.03813" ixy="0.0" ixz="0.0" 
                iyy="0.1843" iyz="0.0" 
                izz="0.1468" />
        </inertial>
    </link>

    <link name="back_bar_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/back_bar.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <origin xyz="0 0 0.015" rpy="0 0 0" />
            <geometry>
                <box size="0.089 1.160 0.08955" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.007051" rpy="0 0 0"/>            
            <mass value="1.16448"/>          
            <inertia 
                ixx="0.1067" ixy="0.0" ixz="0.0" 
                iyy="0.0006767" iyz="0.0" 
                izz="0.1064" />
        </inertial>
    </link>



    <link name="left_wheel_front_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/motor_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0.0 -0.003705 0.0" rpy="0 0 0"/>
            
            <mass value="5.55023"/>
            
            <inertia 
                ixx="0.01495" ixy="0.0" ixz="0.0" 
                iyy="0.02667" iyz="0.0" 
                izz="0.01495" />
        </inertial>
    </link>

    <link name="left_wheel_back_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/motor_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0.0 -0.003705 0.0" rpy="0 0 0"/>
            
            <mass value="5.55023"/>
            
            <inertia 
                ixx="0.01495" ixy="0.0" ixz="0.0" 
                iyy="0.02667" iyz="0.0" 
                izz="0.01495" />
        </inertial>
    </link>

    <link name="right_wheel_front_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/motor_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 ${pi}" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0.0 0.003705 0.0" rpy="0 0 0"/>
            
            <mass value="5.55023"/>
            
            <inertia 
                ixx="0.01495" ixy="0.0" ixz="0.0" 
                iyy="0.02667" iyz="0.0" 
                izz="0.01495" />
        </inertial>
    </link>

    <link name="right_wheel_back_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/motor_wheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 ${pi}" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0.0 0.003705 0.0" rpy="0 0 0"/>
            
            <mass value="5.55023"/>
            
            <inertia 
                ixx="0.01495" ixy="0.0" ixz="0.0" 
                iyy="0.02667" iyz="0.0" 
                izz="0.01495" />
        </inertial>
    </link>



    <link name="y_axis_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/y_axis.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 -0.055 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.4 0.02 0.06" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>            
            <mass value="0.37599"/>           
            <inertia 
                ixx="0.0001717" ixy="0.0" ixz="0.0" 
                iyy="0.005167"  iyz="0.0" 
                izz="0.005032" />
        </inertial>
    </link>

    <link name="z_carriage_link">
        <inertial>
            <mass value="0.001" />
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
        </inertial>
    </link>

    <link name="z_axis_link">
        <visual>           
            <geometry>
                <mesh filename="package://robot_description/meshes/z_axis.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <origin xyz="0 0 0.275" rpy="0 0 0" />
            <geometry>
                <box size="0.0195 0.0195 0.55" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.275" rpy="0 0 0"/>           
            <mass value="0.23431"/>            
            <inertia 
                ixx="0.005916" ixy="0.0" ixz="0.0" 
                iyy="0.005916" iyz="0.0" 
                izz="0.00001918" />
        </inertial>
    </link>


    ``----- JOINTS -----

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${frame_ground_offset}" rpy="0 0 0" />
    </joint>

    <joint name="gantry_origin_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gantry_origin_link"/>
        <origin xyz="${y_axis_travel/2} ${-x_axis_travel/2} 0" rpy="0 0 ${pi/2}"/>
    </joint>

    <joint name="base_left_leg_joint" type="fixed">
        <parent link="base_link" />
        <child link="left_leg_link" />
        <origin xyz="0 ${-leg_offset_y} ${-leg_offset_z}" rpy="0 0 0" />
    </joint>

    <joint name="base_right_leg_joint" type="fixed">
        <parent link="base_link" />
        <child link="right_leg_link" />
        <origin xyz="0 ${leg_offset_y} ${-leg_offset_z}" rpy="0 0 0" />
    </joint>

    <joint name="base_back_bar_joint" type="fixed">
        <parent link="base_link" />
        <child link="back_bar_link" />
        <origin xyz="${-back_bar_offset_x} 0 ${-back_bar_offset_z}" rpy="0 0 0" />
    </joint>



    <joint name="left_leg_front_wheel_joint" type="continuous">
        <parent link="left_leg_link" />
        <child link="left_wheel_front_link" />
        <origin xyz="${front_wheel_offset_x} ${-wheel_offset_y} ${-wheel_offset_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <joint name="left_leg_back_wheel_joint" type="continuous">
        <parent link="left_leg_link" />
        <child link="left_wheel_back_link" />
        <origin xyz="${-back_wheel_offset_x} ${-wheel_offset_y} ${-wheel_offset_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <joint name="right_leg_front_wheel_joint" type="continuous">
        <parent link="right_leg_link" />
        <child link="right_wheel_front_link" />
        <origin xyz="${front_wheel_offset_x} ${wheel_offset_y} ${-wheel_offset_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    <joint name="right_leg_back_wheel_joint" type="continuous">
        <parent link="right_leg_link" />
        <child link="right_wheel_back_link" />
        <origin xyz="${-back_wheel_offset_x} ${wheel_offset_y} ${-wheel_offset_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>

    

    <joint name="x_axis_joint" type="prismatic">
        <parent link="gantry_origin_link" />
        <child link="y_axis_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0" rpy="0 0 0" />
        <limit lower="-0.005" upper="${x_axis_travel}" velocity="0.15" effort="100" />
    </joint>

    <joint name="y_axis_joint" type="prismatic">
        <parent link="y_axis_link" />
        <child link="z_carriage_link" />
        <origin xyz="${z_axis_offset_x} 0 ${z_axis_offset_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" rpy="0 0 0" />
        <limit lower="-0.005" upper="${y_axis_travel}" velocity="0.038" effort="100" />
    </joint>

    <joint name="z_axis_joint" type="prismatic">
        <parent link="z_carriage_link" />
        <child link="z_axis_link" />
        <origin xyz="0 0 0" rpy="${pi} 0 0" />
        <axis xyz="0 0 1" rpy="0 0 0" />
        <limit lower="-0.005" upper="${z_axis_travel}" velocity="0.038" effort="100" />
    </joint>


</robot>
<!-- ros2 launch robot_bringup robot.launch.xml -->
<launch>
    <!-- Kill any surviving ros2_control_node from a crashed/aborted session.
         A zombie node keeps JTC alive with stale desired positions: after homing
         resets encoders to 0, JTC immediately drives the gantry back to wherever
         it was commanded last session. -->
    <executable cmd="bash -c 'pkill -9 -f ros2_control_node; fuser -k 9090/tcp 2>/dev/null; true'" shell="true" />

    <let name="urdf_path"
        value="$(find-pkg-share robot_description)/urdf/selena_robot.urdf.xacro" />
    <let name="robot_description"
        value="$(command 'xacro $(var urdf_path)')" />

    <node pkg="robot_state_publisher"
        exec="robot_state_publisher"
        name="robot_state_publisher">
        <param name="robot_description" value="$(var robot_description)" />
    </node>

    <node pkg="controller_manager"
        exec="ros2_control_node"
        name="controller_manager"
        output="screen">
        <param name="robot_description" value="$(var robot_description)" />
        <param from="$(find-pkg-share robot_bringup)/config/robot_controllers.yaml" />
    </node>

    <!-- These controllers carry no per-session position state — spawn immediately. -->
    <node pkg="controller_manager"
        exec="spawner"
        args="joint_state_broadcaster" />

    <node pkg="controller_manager"
        exec="spawner"
        args="diff_drive_controller" />

    <!-- Inactive by default — activated for manual teleop -->
    <node pkg="controller_manager"
        exec="spawner"
        args="gantry_velocity_controller --inactive" />

    <node pkg="robot_gripper"
        exec="gripper_interface_node"
        name="gripper_interface_node"
        output="screen" />

    <!-- JTC uses controller-manager-timeout 120 so the spawner waits up to 120 s
         for controller_manager services. Those services only start AFTER hardware
         activation (i.e. after homing completes), so JTC always initialises from
         position 0 (home) and never replays a stale desired position. -->
    
    <node pkg="controller_manager"
        exec="spawner"
        args="joint_trajectory_controller --controller-manager-timeout 120" />

    <!-- Single control point for all gantry motion — starts after JTC is active -->
    <node pkg="robot_gantry"
        exec="gantry_node"
        name="gantry_node"
        output="screen">
        <param name="robot_description" value="$(var robot_description)" />
    </node>

    <node pkg="robot_missions"
        exec="mission_server"
        name="mission_server"
        output="screen">
        <param from="$(find-pkg-share robot_missions)/config/tray_positions.yaml" />
    </node>

    <include file="$(find-pkg-share robot_web_app)/launch/web_app.launch.xml" />
</launch>
